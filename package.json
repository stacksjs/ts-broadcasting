{
  "name": "ts-broadcasting",
  "type": "module",
  "version": "0.0.13",
  "description": "A high-performance, real-time WebSocket broadcasting system for TypeScript, built on Bun.",
  "author": "Chris Breuer <chris@stacksjs.org>",
  "license": "MIT",
  "homepage": "https://github.com/stacksjs/ts-broadcasting#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stacksjs/ts-broadcasting.git"
  },
  "bugs": {
    "url": "https://github.com/stacksjs/ts-broadcasting/issues"
  },
  "keywords": [
    "ts-broadcasting",
    "typescript",
    "realtime",
    "websockets",
    "laravel-echo"
  ],
  "scripts": {
    "build": "bun --bun build.ts",
    "fresh": "bunx rimraf node_modules/ bun.lock && bun i",
    "test": "bun test",
    "lint": "bunx --bun pickier .",
    "lint:fix": "bunx --bun pickier . --fix",
    "format": "bunx --bun pickier . --format",
    "format:fix": "bunx --bun pickier . --format --write",
    "format:check": "bunx --bun pickier format --check",
    "changelog": "bunx @stacksjs/logsmith --verbose",
    "changelog:generate": "bunx @stacksjs/logsmith --output CHANGELOG.md",
    "release": "bunx --bun @stacksjs/bumpx prompt --recursive --commit --tag --push",
    "release:patch": "bunx --bun @stacksjs/bumpx patch --recursive --commit --tag --push --yes",
    "release:minor": "bunx --bun @stacksjs/bumpx minor --recursive --commit --tag --push --yes",
    "release:major": "bunx --bun @stacksjs/bumpx major --recursive --commit --tag --push --yes",
    "dev:docs": "bun --bun bunpress dev docs",
    "build:docs": "bun --bun bunpress build docs",
    "preview:docs": "bun --bun bunpress preview docs",
    "typecheck": "bun --bun tsc --noEmit",
    "test:package": "bun test ./packages/ts-broadcasting/test/package.acceptance.ts",
    "prepublishOnly": "bun run build:release",
    "compile": "bun build ./packages/ts-broadcasting/bin/cli.ts --compile --minify --outfile bin/broadcast",
    "compile:all": "bun run compile:linux-x64 && bun run compile:linux-arm64 && bun run compile:windows-x64 && bun run compile:darwin-x64 && bun run compile:darwin-arm64",
    "compile:linux-x64": "bun build ./packages/ts-broadcasting/bin/cli.ts --compile --minify --target=bun-linux-x64 --outfile bin/broadcast-linux-x64",
    "compile:linux-arm64": "bun build ./packages/ts-broadcasting/bin/cli.ts --compile --minify --target=bun-linux-arm64 --outfile bin/broadcast-linux-arm64",
    "compile:windows-x64": "bun build ./packages/ts-broadcasting/bin/cli.ts --compile --minify --target=bun-windows-x64 --outfile bin/broadcast-windows-x64.exe",
    "compile:darwin-x64": "bun build ./packages/ts-broadcasting/bin/cli.ts --compile --minify --target=bun-darwin-x64 --outfile bin/broadcast-darwin-x64",
    "compile:darwin-arm64": "bun build ./packages/ts-broadcasting/bin/cli.ts --compile --minify --target=bun-darwin-arm64 --outfile bin/broadcast-darwin-arm64",
    "zip": "cd bin && zip -j broadcast-linux-x64.zip broadcast-linux-x64 && zip -j broadcast-linux-arm64.zip broadcast-linux-arm64 && zip -j broadcast-windows-x64.zip broadcast-windows-x64.exe && zip -j broadcast-darwin-x64.zip broadcast-darwin-x64 && zip -j broadcast-darwin-arm64.zip broadcast-darwin-arm64",
    "build:release": "bun run build && bun run compile && bun run compile:all && bun run zip && bun run test:package"
  },
  "devDependencies": {
    "better-dx": "^0.2.40"
  },
  "workspaces": [
    "packages/**"
  ],
  "git-hooks": {
    "pre-commit": {
      "staged-lint": {
        "*.{js,ts,json,yaml,yml,md}": "bunx --bun pickier lint --fix"
      }
    },
    "commit-msg": "bunx gitlint --edit .git/COMMIT_EDITMSG"
  },
  "dependencies": {
    "@stacksjs/clarity": "^0.3.33",
    "bunfig": "^0.15.21"
  },
  "overrides": {
    "typescript": "^7.0.2"
  },
  "private": true
}
